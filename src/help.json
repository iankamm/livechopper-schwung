{
  "title": "Chopper",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Chop a WAV across",
        "pads in real time,",
        "like MPC and SP",
        "chop modes.",
        "",
        "Play Pad 1, then hit",
        "the blue pad to cut",
        "at the playhead.",
        "Playback carries on",
        "into the new slice.",
        "",
        "Up to 16 slices on",
        "the left 4x4 pads,",
        "Pad 1 bottom-left."
      ]
    },
    {
      "title": "Controls",
      "lines": [
        "Red pad: play slice",
        " (one-shot), selects",
        "Blue pad: chop at",
        " playhead while a",
        " slice plays",
        "Delete: delete the",
        " selected slice",
        " (merges it into",
        " the previous pad;",
        " Pad 1 is trimmed",
        " off the start)",
        "Undo: undo last",
        " chop or delete",
        "Shift+Undo: redo",
        "Capture: export",
        "Back: exit (asks if",
        " not exported)"
      ]
    },
    {
      "title": "Fine-tuning",
      "lines": [
        "Knob 1: move start",
        "Knob 2: move end",
        "Knob 3: zoom",
        "Knob 4: wave scale",
        "Jog: move active",
        " marker",
        "Jog click: switch",
        " start/end",
        "Shift: fine steps",
        "Left/Right: select",
        " prev/next pad",
        "",
        "Chop points are",
        "shared: moving a",
        "pad's start moves",
        "the previous pad's",
        "end too."
      ]
    },
    {
      "title": "Sound",
      "lines": [
        "These apply to all",
        "pads and carry into",
        "the export.",
        "",
        "Knob 5: attack",
        "Knob 6: hold",
        "  (top = Full)",
        "Knob 7: decay",
        "Knob 8: transpose",
        " (-24 to +24 semis,",
        " changes speed too)",
        "Shift: fine steps",
        "",
        "Touch any knob to",
        "see its value."
      ]
    },
    {
      "title": "Export",
      "lines": [
        "Capture: save the",
        "slices as a drum",
        "rack preset in",
        "Track Presets.",
        "",
        "Named after the",
        "sample + Chop. Never",
        "overwrites: a second",
        "export gets a 2.",
        "",
        "Load it on a drum",
        "track. Envelope,",
        "transpose and choke",
        "carry over. Gate,",
        "per-pad sound etc.",
        " are set there."
      ]
    }
  ]
}
