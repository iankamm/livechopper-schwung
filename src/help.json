{
  "title": "LiveChopper",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Chop a WAV across",
        "pads by ear, while",
        "it plays (MPC-style",
        "\"lazy chop\").",
        "",
        "Play Pad 1, then hit",
        "the blue pad to cut",
        "at the playhead.",
        "Playback carries on",
        "into the new slice.",
        "",
        "Up to 16 slices on",
        "the left 4x4 pads,",
        "Pad 1 bottom-left."
      ]
    },
    {
      "title": "Controls",
      "lines": [
        "Red pad: play slice",
        " and select it",
        "Blue pad: chop at",
        " playhead while a",
        " slice plays",
        "Delete: delete the",
        " selected slice",
        " (merges it into",
        " the previous pad;",
        " Pad 1 is trimmed",
        " off the start)",
        "Undo: undo last",
        " chop or delete",
        "Shift+Undo: redo",
        "Record: export menu",
        "Down/Up: Filter &",
        " Setup / Main knobs",
        "Shift+Jog click:",
        " tools menu",
        "Play: play/stop the",
        " Move set (set tempo",
        " and metronome in",
        " Move first)",
        "Back: menu",
        " Keep for later:",
        " leave it running;",
        " Tools > LiveChopper",
        " > Resume to return",
        " (e.g. after a tempo",
        " change in Move)",
        " Discard and exit:",
        " close for good"
      ]
    },
    {
      "title": "Fine-tuning",
      "lines": [
        "Knob 2: move start",
        "Shift+Knob 2: zoom",
        "Knob 5 as Length",
        " (Shift+tap): move",
        " the end",
        "Jog: move start",
        "Shift: fine steps",
        "Left/Right: select",
        " prev/next pad",
        "",
        "Chop points are",
        "shared: moving a",
        "pad's start moves",
        "the previous pad's",
        "end too."
      ]
    },
    {
      "title": "Main knobs",
      "lines": [
        "Laid out like Move's",
        "Drum Sampler. These",
        "apply to all pads",
        "and carry into the",
        "export.",
        "",
        "Knob 1: transpose",
        " (-48 to +48 semis,",
        " changes speed too)",
        "Shift+Knob 1: detune",
        " (-50 to +50 cents)",
        "Knob 2: move start",
        "Shift+Knob 2: zoom",
        "Knob 3: attack",
        "Knob 4: hold",
        "  (top = Full)",
        "Knob 5: decay",
        "Shift+tap Knob 5:",
        " Length instead (the",
        " slice's end, as %",
        " of the sample); tap",
        " again for decay",
        "Knob 6: effect, Off",
        " or 8-Bit (the drum",
        " sampler's effect)",
        "Knob 7: 8-Bit rate",
        " (1 to 30 kHz)",
        "Shift: fine steps",
        "",
        "Touch any knob to",
        "see its value."
      ]
    },
    {
      "title": "Filter & Setup",
      "lines": [
        "Down: these knobs;",
        "Up: back to Main.",
        "",
        "Knob 1: filter",
        " frequency (30 Hz",
        " to 22 kHz)",
        "Knob 2: resonance",
        " (0-90%); on Peak:",
        " Peak gain, +-12 dB",
        "Knob 3: filter type",
        " LP12, LP24, HP24,",
        " Peak (LP24 at",
        " 22 kHz: no filter)",
        "Knob 4: mode,",
        " Trigger (one-shot)",
        " or Gate (plays",
        " while the pad is",
        " held)",
        "Knob 8: gain (-70",
        " to +24 dB; the",
        " waveform follows)",
        "Shift: fine steps"
      ]
    },
    {
      "title": "Export",
      "lines": [
        "Record opens the",
        "export menu. Jog to",
        "choose, click to do",
        "it, Back to close.",
        "",
        "Name: click to type",
        " a new name (starts",
        " as sample + Chop)",
        "Drum Preset: a drum",
        " rack preset in",
        " Track Presets",
        "Slices: one WAV per",
        " pad in a folder",
        " next to the sample",
        "Cancel: close",
        "",
        "Never overwrites: a",
        "second export gets",
        "a 2.",
        "",
        "Load the preset on",
        "a drum track.",
        "Envelope, one-shot/",
        "gated, gain,",
        "transpose, detune,",
        "crush, filter and",
        "choke carry over.",
        "Slice WAVs get the",
        "gain.",
        "Per-pad sound etc.",
        " are set there."
      ]
    },
    {
      "title": "Tools",
      "lines": [
        "Shift+Jog click",
        "opens Tools. Jog to",
        "choose, click to do",
        "it, Back to close.",
        "",
        "Normalize audio:",
        " sets Gain so the",
        " sample's peak is",
        " at 0 dB. The file",
        " is not changed;",
        " the Gain knob",
        " adjusts it from",
        " there.",
        "Channels: make a",
        " stereo sample",
        " Mono (L+R), Left",
        " only or Right",
        " only. Asks first,",
        " then replaces the",
        " file with a",
        " 1-channel one.",
        " Slices are kept.",
        "Back: close"
      ]
    }
  ]
}
