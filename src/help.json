{
  "title": "Chopper",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Chop a WAV across",
        "pads in real time,",
        "like MPC and SP",
        "chop modes.",
        "",
        "Play Pad 1, then hit",
        "the blue pad to cut",
        "at the playhead.",
        "Playback carries on",
        "into the new slice.",
        "",
        "Up to 16 slices on",
        "the left 4x4 pads,",
        "Pad 1 bottom-left."
      ]
    },
    {
      "title": "Controls",
      "lines": [
        "Red pad: play slice",
        " while held, select",
        " it (let go: Decay",
        " fades it out)",
        "Blue pad: chop at",
        " playhead while a",
        " slice plays",
        "Delete: delete the",
        " selected slice",
        " (merges it into",
        " the previous pad;",
        " Pad 1 is trimmed",
        " off the start)",
        "Undo: undo last",
        " chop or delete",
        "Shift+Undo: redo",
        "Record: export menu",
        "Play: play/stop the",
        " Move set (set tempo",
        " and metronome in",
        " Move first)",
        "Back: menu",
        " Keep for later:",
        " leave it running;",
        " Tools > Chopper >",
        " Resume to return",
        " (e.g. after a tempo",
        " change in Move)",
        " Discard and exit:",
        " close for good"
      ]
    },
    {
      "title": "Fine-tuning",
      "lines": [
        "Knob 1: move start",
        "Knob 2: move end",
        "Knob 3: zoom",
        "Knob 4: wave scale",
        "Jog: move start",
        "Shift: fine steps",
        "Left/Right: select",
        " prev/next pad",
        "",
        "Chop points are",
        "shared: moving a",
        "pad's start moves",
        "the previous pad's",
        "end too."
      ]
    },
    {
      "title": "Sound",
      "lines": [
        "These apply to all",
        "pads and carry into",
        "the export.",
        "",
        "Knob 5: attack",
        "Knob 6: hold",
        "  (top = Full)",
        "Knob 7: decay, the",
        " fade after you let",
        " go (max 30 s, the",
        " default, plays out",
        " like a one-shot)",
        "Knob 8: transpose",
        " (-24 to +24 semis,",
        " changes speed too)",
        "Shift: fine steps",
        "",
        "Touch any knob to",
        "see its value."
      ]
    },
    {
      "title": "Export",
      "lines": [
        "Record opens the",
        "export menu. Jog to",
        "choose, click to do",
        "it, Back to close.",
        "",
        "Name: click to type",
        " a new name (starts",
        " as sample + Chop)",
        "Slices: one WAV per",
        " pad in a folder",
        " next to the sample",
        "Drum Preset: a drum",
        " rack preset in",
        " Track Presets",
        "Cancel: close",
        "",
        "Never overwrites: a",
        "second export gets",
        "a 2.",
        "",
        "Load the preset on",
        "a drum track.",
        "Envelope, transpose",
        "and choke carry",
        "over (decay up to",
        "Move's 10 s max).",
        "Per-pad sound etc.",
        " are set there."
      ]
    }
  ]
}
