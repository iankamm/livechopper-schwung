{
  "title": "Chopper",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Chop a WAV across",
        "pads in real time,",
        "like MPC and SP",
        "chop modes.",
        "",
        "Play Pad 1, then hit",
        "the blue pad to cut",
        "at the playhead.",
        "Playback carries on",
        "into the new slice.",
        "",
        "Up to 16 slices on",
        "the left 4x4 pads,",
        "Pad 1 bottom-left."
      ]
    },
    {
      "title": "Controls",
      "lines": [
        "Red pad: play slice",
        " (one-shot)",
        "Blue pad: chop at",
        " playhead while a",
        " slice plays",
        "Back: exit"
      ]
    }
  ]
}
