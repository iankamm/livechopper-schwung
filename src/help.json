{
  "title": "LiveChopper",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Chop a WAV across",
        "pads by ear, while",
        "it plays (MPC-style",
        "\"lazy chop\").",
        "",
        "Play Pad 1, then hit",
        "the blue pad to cut",
        "at the playhead.",
        "Playback carries on",
        "into the new slice.",
        "",
        "Up to 16 slices on",
        "the left 4x4 pads,",
        "Pad 1 bottom-left."
      ]
    },
    {
      "title": "Controls",
      "lines": [
        "Red pad: play slice",
        " and select it",
        "Mute: one-shot (lit)",
        " or gated (dark):",
        " gated plays while",
        " the pad is held",
        "Blue pad: chop at",
        " playhead while a",
        " slice plays",
        "Delete: delete the",
        " selected slice",
        " (merges it into",
        " the previous pad;",
        " Pad 1 is trimmed",
        " off the start)",
        "Undo: undo last",
        " chop or delete",
        "Shift+Undo: redo",
        "Record: export menu",
        "Shift+Jog click:",
        " tools menu",
        "Play: play/stop the",
        " Move set (set tempo",
        " and metronome in",
        " Move first)",
        "Back: menu",
        " Keep for later:",
        " leave it running;",
        " Tools > LiveChopper",
        " > Resume to return",
        " (e.g. after a tempo",
        " change in Move)",
        " Discard and exit:",
        " close for good"
      ]
    },
    {
      "title": "Fine-tuning",
      "lines": [
        "Knob 1: move start",
        "Knob 2: move end",
        "Knob 3: zoom",
        "Jog: move start",
        "Shift: fine steps",
        "Left/Right: select",
        " prev/next pad",
        "",
        "Chop points are",
        "shared: moving a",
        "pad's start moves",
        "the previous pad's",
        "end too."
      ]
    },
    {
      "title": "Sound",
      "lines": [
        "These apply to all",
        "pads and carry into",
        "the export.",
        "",
        "Knob 4: gain (-70",
        " to +24 dB; the",
        " waveform follows)",
        "Knob 5: attack",
        "Knob 6: hold",
        "  (top = Full)",
        "Knob 7: decay",
        "Knob 8: transpose",
        " (-24 to +24 semis,",
        " changes speed too)",
        "Shift+Knob 8: detune",
        " (-50 to +50 cents)",
        "Shift+Knob 3: crush",
        " (drum sampler 8-Bit",
        " effect; top = Off,",
        " then 30 to 1 kHz)",
        "Shift: fine steps",
        "",
        "Touch any knob to",
        "see its value."
      ]
    },
    {
      "title": "Export",
      "lines": [
        "Record opens the",
        "export menu. Jog to",
        "choose, click to do",
        "it, Back to close.",
        "",
        "Name: click to type",
        " a new name (starts",
        " as sample + Chop)",
        "Drum Preset: a drum",
        " rack preset in",
        " Track Presets",
        "Slices: one WAV per",
        " pad in a folder",
        " next to the sample",
        "Cancel: close",
        "",
        "Never overwrites: a",
        "second export gets",
        "a 2.",
        "",
        "Load the preset on",
        "a drum track.",
        "Envelope, one-shot/",
        "gated, gain,",
        "transpose, detune",
        "and choke carry",
        "over. Slice WAVs",
        "get the gain.",
        "Per-pad sound etc.",
        " are set there."
      ]
    },
    {
      "title": "Tools",
      "lines": [
        "Shift+Jog click",
        "opens Tools. Jog to",
        "choose, click to do",
        "it, Back to close.",
        "",
        "Normalize audio:",
        " sets Gain so the",
        " sample's peak is",
        " at 0 dB. The file",
        " is not changed;",
        " Knob 4 adjusts it",
        " from there.",
        "Channels: make a",
        " stereo sample",
        " Mono (L+R), Left",
        " only or Right",
        " only. Asks first,",
        " then replaces the",
        " file with a",
        " 1-channel one.",
        " Slices are kept.",
        "Back: close"
      ]
    }
  ]
}
